{
    "name": "pqsound",
    "version": "0.1.0",
    "description": "",
    "scripts": {
        "start": "node --max-old-space-size=128 -r ts-node/register  ./src/start.ts",
        "lint": "eslint --fix .",
        "test": "jest",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test:e2e": "playwright test --config playwright/playwright.config.ts",
        "test:e2e:ui": "playwright test --config playwright/playwright.config.ts --ui",
        "start:local": "nodemon --config ./utils/nodemon.json",
        "start:local:so": "env SERVER_ONLY=true nodemon --config ./utils/nodemon.json",
        "prepare": "(git config core.hooksPath .githooks && git config merge.graphify.driver \"graphify merge-driver %O %A %B\") || exit 0",
        "": "--------------------------------------------------------------------------",
        "build": "rm -rf dist && node -r ts-node/register ./node_modules/webpack/bin/webpack.js --config src/webpackCfg/webpack.config.ts",
        "build:local": "rm -rf dist && cross-env NODE_ENV=local NODE_HOST=local node -r ts-node/register ./node_modules/webpack/bin/webpack.js --config src/webpackCfg/webpack.config.ts"
    },
    "keywords": [
        "express",
        "webpack",
        "node",
        "react",
        "redux",
        "audio",
        "synth"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/ItsMeaga1n/PqSound.git"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "author": "Patryq",
    "license": "ISC",
    "devDependencies": {
        "@flydotio/dockerfile": "^0.7.10",
        "@playwright/test": "1.62.0",
        "@types/jest": "^30.0.0",
        "@types/react": "16.9.35",
        "@types/react-dom": "16.9.8",
        "@types/styled-components": "5.1.36",
        "@types/webmidi": "3.0.1",
        "@typescript-eslint/eslint-plugin": "8.65.0",
        "@typescript-eslint/parser": "8.65.0",
        "css-loader": "7.1.4",
        "eslint": "10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "7.37.5",
        "fork-ts-checker-webpack-plugin": "^9.1.0",
        "globals": "^17.8.0",
        "jest": "^30.4.2",
        "mini-css-extract-plugin": "^2.9.2",
        "prettier": "^3.9.6",
        "redux-devtools-extension": "2.13.9",
        "source-map-loader": "^5.0.0",
        "style-loader": "4.0.0",
        "ts-jest": "^29.4.12",
        "ts-loader": "^9.5.4",
        "typescript-eslint": "^8.65.0"
    },
    "dependencies": {
        "@overnightjs/core": "^1.7.6",
        "@overnightjs/logger": "^1.2.1",
        "@types/express": "5.0.6",
        "cross-env": "10.1.0",
        "express": "^5.2.1",
        "file-loader": "6.2.0",
        "html-webpack-plugin": "^5.6.8",
        "http-status-codes": "^2.3.0",
        "nodemon": "^3.1.14",
        "normalize.css": "8.0.1",
        "npm": "^12.0.1",
        "react": "16.14.0",
        "react-bootstrap": "2.10.10",
        "react-bootstrap-icons": "1.11.6",
        "react-dom": "16.14.0",
        "react-dropzone": "16.0.0",
        "react-loader-spinner": "6.1.6",
        "react-redux": "8.1.3",
        "redux": "4.0.5",
        "redux-logger": "3.0.6",
        "redux-thunk": "2.4.2",
        "ts-node": "^10.9.2",
        "tslib": "^2.8.1",
        "typescript": "^6.0.3",
        "webpack": "5.108.4",
        "webpack-cli": "^7.2.1",
        "webpack-dev-middleware": "8.1.1",
        "webpack-hot-middleware": "^2.26.1"
    }
}
