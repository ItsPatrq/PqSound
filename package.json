{
    "name": "pqsound",
    "version": "0.1.0",
    "description": "",
    "scripts": {
        "start": "node --max-old-space-size=128 -r ./utils/typescript6.js -r ts-node/register/transpile-only ./src/start.ts",
        "lint": "eslint --fix .",
        "test": "jest",
        "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
        "test:e2e": "playwright test --config playwright/playwright.config.ts",
        "test:e2e:ui": "playwright test --config playwright/playwright.config.ts --ui",
        "start:local": "nodemon --config ./utils/nodemon.json",
        "start:local:so": "env SERVER_ONLY=true nodemon --config ./utils/nodemon.json",
        "prepare": "(git config core.hooksPath .githooks && git config merge.graphify.driver \"graphify merge-driver %O %A %B\") || exit 0",
        "": "--------------------------------------------------------------------------",
        "build": "rm -rf dist && node -r ./utils/typescript6.js -r ts-node/register ./node_modules/webpack/bin/webpack.js --config src/webpackCfg/webpack.config.ts",
        "build:local": "rm -rf dist && cross-env NODE_ENV=local NODE_HOST=local node -r ./utils/typescript6.js -r ts-node/register ./node_modules/webpack/bin/webpack.js --config src/webpackCfg/webpack.config.ts",
        "juno:reference": "node -r ./utils/typescript6.js -r ts-node/register/transpile-only tools/juno-reference/render-reference.ts",
        "juno:fit": "node -r ./utils/typescript6.js -r ts-node/register/transpile-only tools/juno-reference/fit-calibration.ts"
    },
    "keywords": [
        "express",
        "webpack",
        "node",
        "react",
        "redux",
        "audio",
        "synth"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/ItsMeaga1n/PqSound.git"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "author": "Patryq",
    "license": "ISC",
    "devDependencies": {
        "@playwright/test": "1.65.1",
        "@types/jest": "^30.0.0",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "css-loader": "7.1.5",
        "eslint": "10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-react": "7.37.5",
        "file-loader": "6.2.0",
        "globals": "^17.14.0",
        "html-webpack-plugin": "^5.6.8",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "mini-css-extract-plugin": "^2.9.2",
        "prettier": "^3.10.1",
        "source-map-loader": "^5.0.0",
        "style-loader": "4.0.0",
        "ts-jest": "^29.4.15",
        "ts-loader": "^9.6.2",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.73.0",
        "webpack": "5.113.0",
        "webpack-cli": "^7.3.1",
        "webpack-dev-middleware": "8.6.3",
        "webpack-hot-middleware": "^2.26.1"
    },
    "dependencies": {
        "@reduxjs/toolkit": "^2.14.0",
        "@types/express": "5.0.6",
        "@typescript/typescript6": "^6.0.2",
        "cross-env": "10.1.0",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.4",
        "nodemon": "^3.1.14",
        "normalize.css": "8.0.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-dropzone": "20.2.1",
        "react-redux": "9.3.1",
        "redux": "5.0.1",
        "ts-node": "^10.9.2",
        "tslib": "^2.9.1"
    },
    "comments": {
        "overrides": "Transitive-only security bumps for advisories with no direct-dependency fix available. Version-scoped so packages pinning an older major are left alone. Drop an entry once the parent dependency ships a fixed range.",
        "typescript": "`typescript` is TS7 (native). Its package has no JS compiler API, so tools that need one get TS6's from `@typescript/typescript6` via utils/typescript6.js. Both packages install a `tsc` bin and npm links the TS6 one, so `typecheck` names TS7's by path."
    },
    "overrides": {
        "js-yaml@^3.0.0": "^3.15.1",
        "js-yaml@^4.0.0": "^4.3.1",
        "brace-expansion@^4.0.0": "^5.0.9"
    }
}
