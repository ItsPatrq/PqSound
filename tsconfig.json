{
  "compileOnSave": true,
  "compilerOptions": {
    "noImplicitAny": false /* Raise error on expressions and declarations with an implied 'any' type. */,
    "allowSyntheticDefaultImports": true /* Allow default imports from modules with no default export. This does not affect code emit, just typechecking. */,
    "sourceMap": true /* Generates corresponding '.map' file. */,
    "target": "ESNEXT" /* Specify ECMAScript target version: 'ES3' (default), 'ES5', 'ES2015', 'ES2016', 'ES2017', 'ES2018', 'ES2019' or 'ESNEXT'. */,
    "jsx": "react" /* Specify JSX code generation: 'preserve', 'react-native', or 'react'. */,
    "types": [
      "react",
      "node",
      "jest"
    ] /* Type declaration files to be included in compilation. WebMIDI types now ship in the TS DOM lib (@types/webmidi 3 is an empty stub). */,
    "module": "commonjs" /* Specify module code generation: 'none', 'commonjs', 'amd', 'system', 'umd', 'es2015', or 'ESNext'. */,
    "moduleResolution": "bundler" /* node10 ('node') was removed in TS7; 'bundler' matches how webpack, Jest and ts-node actually resolve here, and is accepted by both TS6 and TS7. */,
    "experimentalDecorators": true /* Enables experimental support for ES7 decorators. */,
    "emitDecoratorMetadata": true,
    "importHelpers": true,
    "declaration": false /* Generates corresponding '.d.ts' file. */,
    "removeComments": true /* Do not emit comments to output. */,
    "noImplicitReturns": true /* Report error when not all code paths in function return a value. */,
    "noUnusedLocals": false /* Report errors on unused locals. */,
    "strict": true /* Enable all strict type-checking options. */,
    "outDir": "./dist/" /* Redirect output structure to the directory. */,
    "rootDir": "./" /* Explicit source root; TS6 (TS5011) requires this when 'outDir' is set. Repo root covers src plus root-level configs (.eslintrc.js, playwright) pulled in by 'include'. */,
    "paths": {
      /* Mirrors the webpack aliases in src/webpackCfg/defaults.ts and the Jest moduleNameMapper in jest.config.js. Keep the three in sync. No baseUrl (removed in TS7), so targets must start with ./ */
      "actions/*": ["./src/public/daw/js/actions/*"],
      "slices/*": ["./src/public/daw/js/slices/*"],
      "components/*": ["./src/public/daw/js/components/*"],
      "containers/*": ["./src/public/daw/js/containers/*"],
      "engine/*": ["./src/public/daw/js/engine/*"],
      "constants/*": ["./src/public/daw/js/constants/*"],
      "instruments": ["./src/public/daw/js/instruments"],
      "instruments/*": ["./src/public/daw/js/instruments/*"],
      "plugins": ["./src/public/daw/js/plugins"],
      "plugins/*": ["./src/public/daw/js/plugins/*"]
    },
    "typeRoots": [
      "./types",
      "./node_modules/@types"
    ] /* List of folders to include type definitions from. */,
    "strictNullChecks": true /* Enable strict null checks. */,
    "skipLibCheck": true /* Skip type checking of declaration files (avoids errors from third-party .d.ts). */,
    "allowJs": true /* Allow javascript files to be compiled. */
  },
  "exclude": [
    "node_modules",
    "./src/**/*.test.ts"
  ],
  "include": [
    ".",
    "./.eslintrc.js"
  ]
}